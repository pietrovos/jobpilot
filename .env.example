# Use an absolute path so Prisma CLI and the runtime always open the same file.
# Replace this path for your machine. The parent directory must exist.
DATABASE_URL="file:/absolute/path/to/jobpilot/dev.db"
# Production: set NODE_ENV=production in your service manager and terminate HTTPS
# at a trusted reverse proxy. No AUTH_SECRET is used: sessions live in SQLite.
# Uploads are fixed at <process working directory>/uploads; mount persistent disk
# there in production. UPLOADS_DIR is not supported by the application.

# Optional: the header your reverse proxy sets to the client address, such as
# "x-real-ip" or "x-forwarded-for". Only set it when every request passes through
# that proxy. Auth rate limits then apply per client instead of globally.
# TRUSTED_PROXY_IP_HEADER="x-real-ip"

# Optional social sign-in. Each provider stays hidden until both of its values
# are set, so leave the block out to keep password-only login.
# Register these callback URLs with each provider:
#   https://<your-host>/api/auth/oauth/google/callback
#   https://<your-host>/api/auth/oauth/github/callback
#   https://<your-host>/api/auth/oauth/linkedin/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# Optional password reset by email. The "Forgot password?" link stays hidden
# until mail is configured. APP_URL is the public origin used in reset links;
# it is required in production so links never come from the request Host header.
# APP_URL="https://jobs.example.com"
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="JobPilot <no-reply@example.com>"
# For local testing, write messages as JSON files instead of sending them:
# MAIL_OUTBOX="/absolute/path/to/mail-outbox"
