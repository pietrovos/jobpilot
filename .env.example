# Use an absolute path so Prisma CLI and the runtime always open the same file.
# Replace this path for your machine. The parent directory must exist.
DATABASE_URL="file:/absolute/path/to/jobpilot/dev.db"
# Production: set NODE_ENV=production in your service manager and terminate HTTPS
# at a trusted reverse proxy. No AUTH_SECRET is used: sessions live in SQLite.
# Uploads are fixed at <process working directory>/uploads; mount persistent disk
# there in production. UPLOADS_DIR is not supported by the application.
